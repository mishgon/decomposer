!src/decomposer/**
src/decomposer/**/__pycache__/
src/decomposer/**/*.py[cod]
!gyms/
gyms/**
!gyms/toolathlon/
!gyms/toolathlon/**
gyms/toolathlon/**/__pycache__/
gyms/toolathlon/**/*.py[cod]
gyms/toolathlon/subagents/.langgraph_api/
!external/
external/**
!external/toolathlon/
!external/toolathlon/**
external/toolathlon/**/__pycache__/
external/toolathlon/**/*.py[cod]
external/toolathlon/.git
external/toolathlon/node_modules/
external/toolathlon/.venv/
# Machine-local credentials are injected at runtime by run.py. They must never
# become recoverable image layers.
external/toolathlon/configs/global_configs.py
external/toolathlon/configs/token_key_session.py
external/toolathlon/configs/credentials.json
external/toolathlon/configs/google_credentials.json
external/toolathlon/configs/gcp-service_account.keys.json
external/toolathlon/configs/gcp-oauth.keys.json
external/toolathlon/configs/notion_state.json
external/toolathlon/configs/snowflake_rsa_key.p8
external/toolathlon/configs/snowflake_rsa_key.pub
external/toolathlon/configs/.mcp-auth/
external/toolathlon/configs/*.pem
external/toolathlon/configs/*.key
# Deployment startup creates live databases, logs, generated credentials, and
# pid files beside the tracked scripts.  Include only the source files that Git
# tracks there; live service state must neither invalidate builds nor enter an
# image layer.
external/toolathlon/deployment/*/*
!external/toolathlon/deployment/utils/
!external/toolathlon/deployment/utils/**
!external/toolathlon/deployment/*/scripts/
!external/toolathlon/deployment/*/scripts/**
external/toolathlon/deployment/**/__pycache__/
external/toolathlon/deployment/k8s/
