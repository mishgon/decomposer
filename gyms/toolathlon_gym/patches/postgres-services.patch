+  private async withOrderRefunds(orders: any[]): Promise<any[]> {
+    if (!orders.length) return orders;
+    // Fixtures store refunds separately; expose the standard order refund summary.
+    const result = await this.pool.query(
+      `SELECT order_id, id, COALESCE(reason, '') AS reason, (-abs(amount))::text AS total
+       FROM wc.refunds WHERE order_id = ANY($1::bigint[]) ORDER BY id`,
+      [orders.map(order => order.id)]
+    );
+    const refunds = new Map<string, any[]>();
+    for (const { order_id, ...refund } of result.rows) {
+      const key = String(order_id);
+      const list = refunds.get(key) || [];
+      list.push(refund);
+      refunds.set(key, list);
+    }
+    return orders.map(order => ({
+      ...order,
+      refunds: refunds.get(String(order.id)) ?? order.refunds ?? [],
+    }));
+  }
