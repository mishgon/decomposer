diff --git a/verl/utils/tracking.py b/verl/utils/tracking.py
--- a/verl/utils/tracking.py
+++ b/verl/utils/tracking.py
@@ -190,4 +190,14 @@
     def log(self, data, step, backend=None):
+        import os
+
+        if os.environ.get("OPD_ARTIFACTS") and any(k.startswith("val-core/") or k == "critic/rewards/mean" for k in data):
+            from opd.reward_summary import summarize
+
+            try:
+                data = {**data, **summarize(os.environ["OPD_ARTIFACTS"], data, step)}
+            except (OSError, ValueError, KeyError) as error:
+                # Reporting must not discard completed optimizer updates.
+                logger.warning("Unified reward summary unavailable: %s", error)
         for default_backend, logger_instance in self.logger.items():
             if backend is None or default_backend in backend:
                 logger_instance.log(data=data, step=step)
